# Copy this to backend/.env for local development. On Render, set these as
# service environment variables instead — this file is never deployed.

# Required. The app crashes on startup without these two.
MONGO_URL=mongodb://localhost:27017
DB_NAME=serial_experiments

# Required for the moderation API (backend/routers/admin.py) to work at all.
# Blank or unset means every /api/admin/* route rejects with 403.
ADMIN_TOKEN=

# Comma-separated list of allowed frontend origins for CORS. Defaults to the
# production frontend if unset.
CORS_ORIGINS=http://localhost:5173

# Comma-separated list of terms the Wall/Threads content filter rejects.
# Blank/unset disables filtering (a warning is logged on startup).
CONTENT_BLOCKLIST=

# IANA timezone used for date formatting. Defaults to UTC.
APP_TZ=UTC
